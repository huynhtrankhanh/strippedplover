{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist/web",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/web/page.ts", "src/web/indexeddb-database.ts"],
  "exclude": ["node_modules"]
}
